# ---- 原 RAG 链路（/ask）----
DEEPSEEK_API_KEY=your_deepseek_key
SILICONFLOW_API_KEY=your_siliconflow_key
LLM_BASE_URL=https://api.deepseek.com
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
LLM_MODEL=deepseek-chat
CHROMA_DIR=data/chroma

# ---- 访问控制（可选）----
# 设置后，POST /ask 与 POST /agent 必须带请求头 X-API-Key: <值>；不设置则不鉴权（本地开发用）
# 公网部署时强烈建议设置，避免接口被刷额度。GET /health 始终公开。
# API_ACCESS_KEY=change_me_to_a_long_random_string

# ---- Agent 专用 LLM（可选；不填则回退到上面的 LLM_* / DEEPSEEK_API_KEY）----
# 任意 OpenAI 兼容端点均可，例如 SiliconFlow 的 Qwen：
# AGENT_LLM_BASE_URL=https://api.siliconflow.cn/v1
# AGENT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# AGENT_LLM_API_KEY=your_key_optional
# 注意：若 AGENT_LLM_BASE_URL 指向 siliconflow 且未设 AGENT_LLM_API_KEY，会自动复用 SILICONFLOW_API_KEY
